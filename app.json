{
  "expo": {
    "name": "SafeSite",
    "slug": "safesite",
    "scheme": "safesite",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantx.safesite"
    },
    "android": {
      "package": "com.plantx.safesite",
      "adaptiveIcon": {
        "backgroundColor": "#16181D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "SafeSite records a voice note to describe a hazard."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SafeSite takes a photo of the hazard you report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F3F5",
          "image": "./assets/splash-icon.png"
        }
      ],
      "expo-asset",
      "expo-sharing"
    ]
  }
}
