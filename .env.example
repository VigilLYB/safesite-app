# [required] Base URL of the SafeSite API (no trailing slash). [public: bundled into the app]
EXPO_PUBLIC_API_BASE_URL=https://u16drhjo0a.execute-api.ap-south-1.amazonaws.com

# [optional] IANA time zone used to display dates (the plant's local time). Default: Asia/Kolkata
EXPO_PUBLIC_APP_TIME_ZONE=Asia/Kolkata
